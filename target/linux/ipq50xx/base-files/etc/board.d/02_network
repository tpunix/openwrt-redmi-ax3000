#!/bin/sh

. /lib/functions/uci-defaults.sh

ipq50xx_setup_interfaces()
{
	local board="$1"
	case $board in
		ctcc,cmlyq706x)
			ucidef_add_switch "switch1" "6u@eth1" "2:lan:1" "3:lan:2" "4:lan:3"
			ucidef_set_interfaces_lan_wan "eth1" "eth0"
			;;
		redmi,ax3000)
			ucidef_add_switch "switch1" \
				"6u@eth1" "5u@eth0" \
				"1:lan:1" "2:lan:2" "3:lan:3" \
				"4:wan"
			;;
		xiaomi,cr881x)
			ucidef_add_switch "switch0" \
				"8u@eth1" "4u@eth0" \
				"0:lan:1" "1:lan:2" "2:lan:3" \
				"3:wan"
			;;
		cmcc,rax3000q)
			ucidef_add_switch "switch1" \
				"6u@eth1" "3u@eth0" \
				"2:lan:1" "4:lan:2" "5:lan:3" \
				"1:wan"
			;;
	esac
}

board_config_update
board=$(board_name)
ipq50xx_setup_interfaces $board
board_config_flush

exit 0
